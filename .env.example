# Environment Variables for Game Alpha
# Copy to .env and fill in values

# Required: Admin password hash (SHA-256)
# Generate: node -e "console.log(require('crypto').createHash('sha256').update('YOUR_PASSWORD').digest('hex'))"
ADMIN_PASSWORD_HASH=

# Optional: Node environment
NODE_ENV=production

# Optional: Token for the /start slash command to pull unresolved feedback
# from GET /api/public/feedback/open. Generate any random 32-char string.
# Endpoint returns 503 if this is unset.
FEEDBACK_TOKEN=

# Optional: foreign-game text alert. Requires SMTP_* below to also be set
# (sends via your carrier's email-to-SMS gateway, not a dedicated SMS
# service). Can be toggled off from the game's Admin Tools screen without
# touching this file.
#
# Your home network's public IP (check whatismyip.com). Games created from
# this IP are assumed to be you testing and won't trigger a text. Leave
# blank to get a text for every game, including your own. NOTE: home IPs
# can change (ISP reassigns one after an outage/router restart) — if you
# start getting texts for your own testing, re-check whatismyip.com and
# update this value.
HOME_IP=

# Phone number to text (digits only) + its carrier, one of: att, verizon,
# tmobile, sprint, boost, cricket, metropcs, uscellular, googlefi
ALERT_PHONE=
ALERT_CARRIER=
