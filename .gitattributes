# Enforce LF line endings for all text files across all platforms.
# Without this, Windows checkouts get CRLF, which produces large
# noise diffs against this repo's LF-normalized history.
* text=auto eol=lf

# Explicit binary types (no conversion attempted)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
