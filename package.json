{
  "name": "unravel-codes",
  "version": "3.0.31",
  "type": "module",
  "description": "Unravel Codes: The Game - Multi-player board game simulating NYC construction permitting",
  "main": "index.js",
  "scripts": {
    "server": "node server/server.js",
    "test": "vitest run --config vitest.config.dev.ts",
    "test:dev": "vitest run --config vitest.config.dev.ts",
    "test:ci": "vitest run --config vitest.config.ci.ts",
    "test:progress": "./scripts/test-with-progress.sh",
    "test:progress:services": "./scripts/test-with-progress.sh services",
    "test:progress:components": "./scripts/test-with-progress.sh components",
    "test:progress:e2e": "./scripts/test-with-progress.sh e2e",
    "test:watch": "vitest --config vitest.config.dev.ts",
    "test:coverage": "vitest run --coverage",
    "test:verbose": "VITEST_VERBOSE=true vitest run",
    "test:debug": "DEBUG_TESTS=true vitest run --reporter=verbose",
    "test:single": "vitest run --testNamePattern",
    "test:services": "vitest run --config vitest.config.dev.ts tests/services/",
    "test:components": "vitest run --config vitest.config.dev.ts tests/components/",
    "test:e2e": "vitest run --config vitest.config.dev.ts tests/E2E-",
    "test:uat": "vitest run --config vitest.config.dev.ts tests/uat/",
    "test:isolated": "vitest run --config vitest.config.dev.ts tests/isolated/",
    "test:performance": "./scripts/test-performance.sh",
    "test:all": "npm run test:isolated && npm run test:e2e && npm run test:components",
    "test:safe": "echo '🧪 Running tests in safe batches...' && npm run test:isolated && echo '✅ Isolated tests complete' && npm test tests/E2E-05_MultiPlayerEffects.test.ts && echo '✅ E2E-05 complete' && npm test tests/components/game/CardPortfolioDashboard.test.tsx && echo '✅ CardPortfolio complete'",
    "test:core": "echo '🔧 Testing core services...' && npm test tests/services/StateService.test.ts tests/services/DataService.test.ts tests/services/LoggingService.test.ts && echo '✅ Core services complete'",
    "test:game": "echo '🎮 Testing game logic services...' && npm test tests/services/GameRulesService.test.ts tests/services/CardService.test.ts tests/services/ResourceService.test.ts && echo '✅ Game logic complete'",
    "test:comprehensive": "echo '🚀 Running comprehensive test suite...' && npm run test:isolated && npm run test:core && npm run test:game && npm test tests/E2E-05_MultiPlayerEffects.test.ts && npm test tests/components/game/CardPortfolioDashboard.test.tsx && echo '🎉 All critical tests complete!'",
    "build": "vite build",
    "dev": "concurrently --names \"⚡,🖥️\" --prefix-length 2 --prefix-colors \"cyan,magenta\" \"npm:dev:vite\" \"npm:server\"",
    "dev:verbose": "concurrently --names \"VITE,SERVER\" --prefix-colors \"cyan,magenta\" \"npm:dev:vite\" \"npm:server\"",
    "dev:vite": "vite",
    "preview": "vite preview",
    "lint": "eslint src/**/*.{ts,tsx}",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.27.1",
    "@swc/core": "^1.13.5",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.0.16",
    "chokidar": "^5.0.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.32.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "express": "^5.1.0",
    "glob": "^13.0.0",
    "jsdom": "^27.4.0",
    "playwright": "^1.57.0",
    "puppeteer": "^24.33.0",
    "terser": "^5.27.0",
    "tsx": "^4.20.5",
    "typescript": "^5.0.0",
    "vite": "^7.1.2",
    "vitest": "^4.0.16",
    "ws": "^8.14.0"
  },
  "dependencies": {
    "@eslint/js": "^9.39.2",
    "@jalez/react-flow-smart-edge": "^4.0.0",
    "@xyflow/react": "^12.10.2",
    "framer-motion": "^12.29.0",
    "globals": "^17.0.0",
    "html2canvas": "^1.4.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "keywords": [
    "typescript",
    "react",
    "game",
    "architecture",
    "testing"
  ],
  "author": "Claude Code",
  "license": "MIT"
}
